# ==============================================================================
# VARIÁVEIS DE AMBIENTE — EVIDÊNCIAS DE GARANTIA AUTOMOTIVA
# ==============================================================================

# SUPABASE POSTGRESQL & STORAGE (OBRIGATÓRIO PARA INTEGRAÇÃO NUVEM)
# Obtenha estas credenciais no painel do seu projeto Supabase:
# Project Settings > API > Project URL e Project API Keys (anon / public)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-publicavel-aqui"

# ALIAS COMPATÍVEL PARA SUPABASE ANON KEY
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publicavel-aqui"

# BUCKET PRIVADO DE ARMAZENAMENTO NO SUPABASE STORAGE (PADRÃO: warranty-evidence)
VITE_SUPABASE_STORAGE_BUCKET="warranty-evidence"

# GEMINI_API_KEY: Opcional para análises e assistência
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base da aplicação
APP_URL="MY_APP_URL"
